{
  "pluginAlias": "SonyTVAccfactory",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "SonyTVAccfactory",
        "condition": "1=2"
      },
      "devices": {
        "type": "array",
        "items": {
          "title": "Device",
          "type": "object",
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "placeholder": "Host name or IP address"
            },
            "name": {
              "title": "Description",
              "type": "string",
              "placeholder": "Device description for configuration"
            },
            "psk": {
              "type": "string",
              "placeholder": "Uses the default pre-shared key when blank"
            },
            "includeApplications": {
              "type": "boolean"
            },
            "includeChannels": {
              "type": "boolean"
            },
            "exclude": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "host"
          ]
        }
      },
      "options": {
        "type": "object",
        "properties": {
          "autoDiscover": {
            "type": "boolean",
            "default": true
          },
          "psk": {
            "type": "string",
            "default": "0000"
          },
          "pollInterval": {
            "type": "integer",
            "default": 5,
            "minimum": 2,
            "maximum": 300
          },
          "discoveryInterval": {
            "type": "integer",
            "default": 60,
            "minimum": 30,
            "maximum": 3600
          },
          "includeApplications": {
            "type": "boolean",
            "default": false
          },
          "includeChannels": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  },
  "layout": [
    {
      "type": "fieldset",
      "title": "Device Settings",
      "description": "Configure global device settings or override them for specific devices.",
      "expandable": true,
      "expanded": true,
      "items": [
        {
          "key": "options.psk",
          "title": "Default Pre-Shared Key"
        },
        {
          "key": "options.includeApplications",
          "title": "Include Applications as Inputs"
        },
        {
          "key": "options.includeChannels",
          "title": "Include Channels as Inputs"
        },
        {
          "type": "array",
          "title": "Device Overrides",
          "key": "devices",
          "description": "Add devices manually or override settings for specific devices using their host name or IP address.",
          "buttonText": "Add Device Override",
          "orderable": false,
          "arrayItemTitle": "{{value.name || value.host || 'Device'}}",
          "items": [
            {
              "key": "devices[].host",
              "title": "Host"
            },
            {
              "key": "devices[].name",
              "title": "Description"
            },
            {
              "key": "devices[].psk",
              "title": "Pre-Shared Key"
            },
            {
              "key": "devices[].exclude",
              "title": "Exclude Device"
            },
            {
              "key": "devices[].includeApplications",
              "title": "Include Applications as Inputs"
            },
            {
              "key": "devices[].includeChannels",
              "title": "Include Channels as Inputs"
            }
          ],
          "expandable": true,
          "expanded": false
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "Options",
      "expandable": true,
      "expanded": true,
      "items": [
        {
          "key": "options.pollInterval",
          "title": "Polling Interval"
        },
        {
          "key": "options.discoveryInterval",
          "title": "Discovery Interval"
        }
      ]
    }
  ]
}
